---
const { title = 'Ajo' } = Astro.props;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 480px; margin: 0 auto; padding: 1.25rem; line-height: 1.5; }
    input, button { width: 100%; padding: .75rem; margin: .35rem 0; font-size: 1rem; box-sizing: border-box; }
    button { cursor: pointer; }
    .card { border: 1px solid #8884; border-radius: 10px; padding: 1rem; margin: 1rem 0; }
    .err { color: #c0392b; } .row { display: flex; gap: .5rem; } .row button { width: auto; }
  </style>
</head>
<body><slot /></body>
</html>
